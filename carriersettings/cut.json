{
  "about": "OCD rule round 37, item 6: OcdCarrierSettingsDataset moved here from the owner's ROM tree in one commit. Each file with its git blob at the cut; check_cut.py holds the folder to it.",
  "cut": {
    "tree": "vendor/extra (the owner's ROM tree for the Galaxy S20)",
    "branch": "main",
    "commit": "cfa8ee12ca56f7a5ad76bf06529c110e0af2e560",
    "on_top_of": "131caf9dd934d766af7967b9b22b9afbcad16b6b"
  },
  "left_in_the_rom_tree": [
    "carriersettings/AndroidManifest.xml, src/ and privapp-permissions-ocd-carriersettings.xml (the legacy .pb module OcdCarrierSettings)",
    "carriersettings/configs/ (Google's .pb files)",
    "carriersettings/dataset/ (the baked dataset)",
    "carriersettings/ocd-build.json (the S20's cell and its emergency data test first use)",
    "carriersettings/ocd-carriersettings.json (the build record)",
    "carriersettings/__pycache__/ (a stray compiled file)",
    "sepolicy/private/platform_app.te (the S20 keeps its own copy; sepolicy/lineageos here is the same line for other LineageOS builds)"
  ],
  "files": {
    "Android.bp": {
      "from": "carriersettings/Android.bp",
      "blob": "7ea3e4f8f589e274a91240e7e7ebc216ac2481f7",
      "status": "changed",
      "why": "The ruling's conditions: no default writer (the writer genrules fail unless OCD_WRITER_CERT and OCD_WRITER_PACKAGE are set, and accept none); the legacy .pb module OcdCarrierSettings, Google's .pb files, the baked dataset, ocd-build.json and the build record stay in the ROM tree, so their module definitions (OcdCarrierSettings, ocd_carrier_settings, ocd_carrier_dataset, ocd_carrier_build, ocd_carrier_settings_record, privapp_permissions_ocd_carriersettings) are gone from here and the ROM defines the three the provider requires; comments name the new home. OcdCarrierSettingsDataset itself (sources, manifest, resources, flags, overrides, required) is unchanged."
    },
    "README.md": {
      "status": "added",
      "why": "The module's home, the cut, the differences, how a ROM includes it, the writer, the tags and CI."
    },
    "check_build.sh": {
      "from": "carriersettings/check_build.sh",
      "blob": "53194c7325eddcfb0461168495c3d22d62ebb900",
      "status": "changed",
      "why": "Takes the ROM tree's data folder (ROM_DATA_DIR: dataset/, ocd-build.json, device-override.json, configs/) instead of reading them next to itself; no S20 overlay name; the writer has no default."
    },
    "check_build_res.py": {
      "from": "carriersettings/check_build_res.py",
      "blob": "66c419926f3004c952053e342fe3e50c8822ea85",
      "status": "changed",
      "why": "The device override's expected overlay and values come from the ROM tree's device-override.json instead of the S20's built-in values; the writer check has no owner default and accepts none (SM5, round 37)."
    },
    "check_cut.py": {
      "status": "added",
      "why": "Checks this folder against cut.json."
    },
    "check_path_independent.sh": {
      "status": "added",
      "why": "Proves the provider's code is the same under any ROM path: no internal or @JvmName declaration, and the Kotlin compiled under two Soong module names gives identical class files and classes.dex (round 37, step 3)."
