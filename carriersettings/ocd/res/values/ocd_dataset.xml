<resources>
    <!--
        The dataset provider's writer (OCD rule round 31, SM5), with no default writer (round 37,
        item 6). These are base values only: the writer genrules of Android.bp always overlay both
        from the ROM's build parameters OCD_WRITER_CERT and OCD_WRITER_PACKAGE, and fail the build
        when either is unset. Both set to none leave these values: no app can write the dataset.

        ocd_owner_certs: the writer's certificate as `apksigner verify -print-certs` prints its
        SHA-256 digest. Used by the writer permission's knownCerts and by the provider's caller
        check; an empty list admits no app. A digest is public; the key never leaves its owner's
        machine.
    -->
    <string-array name="ocd_owner_certs" translatable="false" />
    <string name="ocd_writer_package" translatable="false">none</string>
</resources>
