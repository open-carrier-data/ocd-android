<?xml version="1.0" encoding="utf-8"?>
<!--
    For a ROM build: the two runtime permissions the background work needs without the
    screen ever opening, granted by DefaultPermissionGrantPolicy on the first boot of a
    system app. Goes to <partition>/etc/default-permissions/. The owner can revoke them
    (fixed="false"). A hand install grants them with `pm grant` instead.

    READ_PHONE_STATE: the active SIMs (also covered by READ_PRIVILEGED_PHONE_STATE).
    POST_NOTIFICATIONS: the live-settings notification with its one-tap "Revert all".
-->
<exceptions>
    <exception package="io.github.open_carrier_data.check.owner">
        <permission name="android.permission.READ_PHONE_STATE" fixed="false" />
        <permission name="android.permission.POST_NOTIFICATIONS" fixed="false" />
    </exception>
</exceptions>
