<?xml version="1.0" encoding="utf-8"?>
<!--
    OCD Check owner build as a privileged system app (the owner's target form, 2026-10-19).
    Install to /system_ext/etc/permissions/ next to the APK in
    /system_ext/priv-app/OcdCheckOwner/OcdCheckOwner.apk (or the /product pair).
    Only for the owner's own ROM; never for a ROM anyone else runs (round 25 OB1, AV2).

    The ROM enforces this list (ro.control_privapp_permissions=enforce): a privileged
    permission the APK asks for and this file lacks stops system_server at boot.
    OwnerManifestTest keeps the two in step. Install this file together with the APK
    that matches it, before the reboot.

    MODIFY_PHONE_STATE: CarrierConfigManager.overrideConfig(subId, bundle), never persistent;
          telecom's isInEmergencyCall for the refusals; also guards the Settings entry's activity.
    READ_PRIVILEGED_PHONE_STATE: the emergency state (callback mode, emergency SMS mode) and
          IMS (ImsMmTelManager registration, capabilities, switches) for the refusals and the
          evidence, through the system APIs.
    READ_PRECISE_PHONE_STATE: the IMS registration callback (a fresh REGISTER over LTE after
          VoLTE's measurement) and the telephony callbacks that stand in for the log.
    WRITE_APN_SETTINGS: the APN trials (a test row in, deleted by its own ID) and their revert.
    DUMP: dumpsys carrier_config, telephony.registry and power, read for the refusals, the
          evidence, the revert proof and the silent window.
    PACKAGE_USAGE_STATS: with DUMP, `dumpsys activity service` of the IWLAN data service and
          QNS (Wi-Fi calling's tunnel, errors and back-off) in place of the device log.
          READ_LOGS is gone (2026-10-20): reading the log makes Android ask the owner, and a
          privileged app cannot skip that prompt.
    CONNECTIVITY_USE_RESTRICTED_NETWORKS (OCD round 30, emergencyDataTest): the emergency data
          test's request for NET_CAPABILITY_EIMS, a restricted network, on the home mobile network
          with the SIM's emergency APN row; waits at most 15 s, released within 5 s, no call and
          nothing sent. Owner build only (signature|privileged, frameworks/base AndroidManifest.xml).
-->
<permissions>
    <privapp-permissions package="io.github.open_carrier_data.check.owner">
        <permission name="android.permission.MODIFY_PHONE_STATE" />
        <permission name="android.permission.READ_PRIVILEGED_PHONE_STATE" />
        <permission name="android.permission.READ_PRECISE_PHONE_STATE" />
        <permission name="android.permission.WRITE_APN_SETTINGS" />
        <permission name="android.permission.DUMP" />
        <permission name="android.permission.PACKAGE_USAGE_STATS" />
        <permission name="android.permission.CONNECTIVITY_USE_RESTRICTED_NETWORKS" />
    </privapp-permissions>

    <!--
        overrideConfig(int, PersistableBundle) is a @SystemApi, reached by reflection
        from an SDK build; a system app on this list is exempt from the hidden-API
        checks (SystemConfig hidden-api-whitelisted-app, honoured in /system_ext and
        /system/etc/permissions).
    -->
    <hidden-api-whitelisted-app package="io.github.open_carrier_data.check.owner" />
</permissions>
