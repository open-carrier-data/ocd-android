<?xml version="1.0" encoding="utf-8"?>
<!--
    The owner build only (src/owner; round 25 B and the owner direction of 2026-10-19).
    Debug and release never merge this file: they keep READ_PHONE_STATE and
    ACCESS_NETWORK_STATE only, without INTERNET (ManifestTest).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Pulls OCD's newest validated main commit from GitHub, pinned by its SHA (owner direction: "update pulls"; round 29). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The quiet live-settings notification with its one-tap "Revert all", and a notice on a change or a failure. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Re-applies the kept values of the SIM in each slot after a boot. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!--
        Round 26 (runtime permissions, not privileged; granted by
        priv-app/default-permissions-ocd-check-owner.xml in a ROM build and by `pm grant`
        on a hand install): the night's muted call to the SIM's own allowlisted mailbox
        (CALL_PHONE), and the removal of exactly that call's call log entry
        (READ_CALL_LOG, WRITE_CALL_LOG); the optional data SMS to the phone's own number
        on the app's port (SEND_SMS, RECEIVE_SMS), off unless the owner turns it on.
    -->
    <uses-permission
        android:name="android.permission.CALL_PHONE"
        tools:ignore="PermissionImpliesUnsupportedChromeOsHardware" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.WRITE_CALL_LOG" />
    <uses-permission
        android:name="android.permission.SEND_SMS"
        tools:ignore="PermissionImpliesUnsupportedChromeOsHardware" />
    <uses-permission
        android:name="android.permission.RECEIVE_SMS"
        tools:ignore="PermissionImpliesUnsupportedChromeOsHardware" />
    <!-- Normal permissions: the microphone muted during the mailbox call; the SIM's MMS network for the MMSC probe. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <!--
        No CHANGE_WIFI_STATE and no READ_LOGS since 2026-10-20: the owner build never
        switches Wi-Fi (VoLTE is measured inside a non-persistent Wi-Fi-calling-off
        override) and never reads the device log (the IWLAN and QNS dumps instead).
    -->

    <!--
        The privileged route: granted only when the app is installed as a priv-app
        with priv-app/privapp-permissions-ocd-check-owner.xml. Installed by adb,
        none of them is granted and the Shizuku route is used.
    -->
    <uses-permission
        android:name="android.permission.MODIFY_PHONE_STATE"
        tools:ignore="ProtectedPermissions,PermissionImpliesUnsupportedChromeOsHardware" />
    <uses-permission
        android:name="android.permission.READ_PRIVILEGED_PHONE_STATE"
        tools:ignore="ProtectedPermissions,PermissionImpliesUnsupportedChromeOsHardware" />
    <uses-permission
        android:name="android.permission.READ_PRECISE_PHONE_STATE"
        tools:ignore="ProtectedPermissions,PermissionImpliesUnsupportedChromeOsHardware" />
    <uses-permission
        android:name="android.permission.WRITE_APN_SETTINGS"
        tools:ignore="ProtectedPermissions,PermissionImpliesUnsupportedChromeOsHardware" />
    <uses-permission
        android:name="android.permission.DUMP"
        tools:ignore="ProtectedPermissions" />
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!--
        Round 29: the writer permission of the ROM's runtime layer (OcdCarrierSettingsLayer,
        com.android.carriersettings). signature|knownSigner, pinned to this build's own
        certificate, so only the owner build gets it; not a privileged permission, so the
        privapp allowlist is unchanged. On a ROM without the layer the permission does not exist
        and is ignored.
    -->
    <uses-permission android:name="com.android.carriersettings.permission.WRITE_OCD_LAYER" />

    <!-- Which IMS stack the phone runs, for video calling's static check (PHH IMS has no video); the runtime layer's provider. -->
    <queries>
        <intent>
            <action android:name="android.telephony.ims.ImsService" />
        </intent>
        <provider android:authorities="com.android.carriersettings.ocdlayer" />
    </queries>

    <!--
        The owner's target form (2026-10-19): a system app with no launcher icon. Its
        screen is the "Open Carrier Data" entry in Settings > Network & internet, and
        the work runs in the background (boot and SIM-change reconcile, the hourly
        quiet job with its light check and the night's tests, update pulls) without
        the screen.
    -->
    <application
        android:label="@string/app_name_owner"
        android:largeHeap="true"
        tools:replace="android:label">

        <!-- No launcher icon: the read-only check stays reachable from the owner screen only. -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="false"
            tools:replace="android:exported">
            <intent-filter tools:node="removeAll" />
        </activity>

        <!--
            The Settings entry. Settings lists activities for IA_SETTINGS only from system
            apps (TileUtils: ResolveInfo.system) and puts this one on the Network & internet
            screen (CategoryKey.CATEGORY_NETWORK, NetworkDashboardFragment), after the SIMs
            (order -15) and before Airplane mode (-5). Guarded by MODIFY_PHONE_STATE: Settings
            (the system uid), Settings search (SettingsIntelligence holds it) and adb open it;
            a normal app cannot.
        -->
        <activity
            android:name=".owner.OwnerActivity"
            android:exported="true"
            android:icon="@drawable/ic_settings_ocd"
            android:label="@string/owner_tools"
            android:permission="android.permission.MODIFY_PHONE_STATE">
            <intent-filter>
                <action android:name="com.android.settings.action.IA_SETTINGS" />
            </intent-filter>
            <meta-data
                android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.wireless" />
            <meta-data
                android:name="com.android.settings.title"
                android:resource="@string/settings_entry_title" />
            <meta-data
                android:name="com.android.settings.summary_uri"
                android:value="content://${applicationId}.settings/getDynamicSummary" />
            <meta-data
                android:name="com.android.settings.icon"
                android:resource="@drawable/ic_settings_ocd" />
            <meta-data
                android:name="com.android.settings.icon_tintable"
                android:value="true" />
            <meta-data
                android:name="com.android.settings.order"
                android:value="-10" />
            <meta-data
                android:name="com.android.settings.keyhint"
                android:value="open_carrier_data" />
        </activity>

        <!-- The entry's live summary; answers only the system, root, the shell and the app. -->
        <provider
            android:name=".owner.OwnerSettingsProvider"
            android:authorities="${applicationId}.settings"
            android:exported="true"
            tools:ignore="ExportedContentProvider" />

        <receiver
            android:name=".owner.RevertAllReceiver"
            android:exported="false" />

        <!-- The revert alarm armed before each background change: queues the cleanup if a step died. -->
        <receiver
            android:name=".owner.RevertAlarmReceiver"
            android:exported="false" />

        <!--
            Round 26's passive call watch: the system's PHONE_STATE broadcast (protected; sent to
            holders of READ_PHONE_STATE, waking them) starts the watch of a real call. It reads
            the call from the registry and never keeps a number.
        -->
        <receiver
            android:name=".owner.PhoneStateReceiver"
            android:exported="true"
            android:permission="android.permission.READ_PRIVILEGED_PHONE_STATE"
            tools:ignore="ExportedReceiver">
            <intent-filter>
                <action android:name="android.intent.action.PHONE_STATE" />
            </intent-filter>
        </receiver>
        <service
            android:name=".owner.CallWatchService"
            android:exported="false" />

        <!--
            The optional data SMS on the app's own port: only the system (BROADCAST_SMS) delivers
            it; the send result comes back to the same receiver through its own PendingIntent.
        -->
        <receiver
            android:name=".owner.SelfSmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.intent.action.DATA_SMS_RECEIVED" />
                <data android:scheme="sms" android:host="localhost" android:port="16123" />
            </intent-filter>
        </receiver>

        <!-- Boot, the app's own update and carrier-config changes (all exempt from the implicit-broadcast limits). -->
        <receiver
            android:name=".owner.OwnerBootReceiver"
            android:exported="true"
            tools:ignore="ExportedReceiver">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.telephony.action.CARRIER_CONFIG_CHANGED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
